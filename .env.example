# Server-only configuration. Copy this file to .env.local and fill locally.
QLOO_ENDPOINT=https://hackathon.api.qloo.com
QLOO_API_KEY=

# Gemini connects directly to Google, from server code only.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# Clerk: publishable key is intentionally public; secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# For credential-free image builds, inject the same public key under this server alias at runtime.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# Private saved-session storage (Cloud Run uses its runtime service identity).
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
