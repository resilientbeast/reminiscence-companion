{
  "name": "reminiscence-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A caregiver-guided activity planner with Qloo-backed cultural evidence.",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/stage-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/policy.test.ts tests/gemini.test.ts tests/planner.test.ts tests/admission.test.ts tests/saved-sessions.test.ts",
    "check:secrets": "node scripts/check-public-artifacts.mjs",
    "test:guard": "node scripts/test-staged-guard.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "smoke": "node scripts/smoke-foundation.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "spike:gemini": "node --conditions=react-server --experimental-strip-types scripts/spike-gemini.mjs",
    "check": "npm run typecheck && npm test && npm run check:secrets"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.106",
    "@clerk/nextjs": "7.9.21",
    "@google-cloud/firestore": "9.4.0",
    "ai": "7.0.154",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
